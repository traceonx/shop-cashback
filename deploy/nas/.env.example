# GitHub Actions 推送到 Docker Hub 的镜像（把 yourname 换成你的 Docker Hub 用户名）。
# 生产环境建议固定为 sha-xxxxxxx 或版本号标签，便于回滚；本机导入镜像时改回 :local。
SERVER_IMAGE=docker.io/yourname/shop-cashback-server:latest
ADMIN_IMAGE=docker.io/yourname/shop-cashback-admin:latest
WEB_BIND=0.0.0.0
WEB_PORT=8081
# 使用随机十六进制字符串；不要使用带 URL 特殊符号的数据库密码。
POSTGRES_PASSWORD=
# 至少 32 字符
JWT_SECRET=
# 64 个十六进制字符；固定保存并与数据库一起备份
CONFIG_ENCRYPTION_KEY=
