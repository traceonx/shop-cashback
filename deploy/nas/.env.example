# GitHub Actions 推送到 Docker Hub 的镜像。
# 生产环境建议固定为 sha-xxxxxxx 或版本号标签，便于回滚；本机导入镜像时改为 shop-cashback:local。
APP_IMAGE=docker.io/sunqz/shop-cashback:latest
WEB_BIND=0.0.0.0
WEB_PORT=8081
# 使用随机十六进制字符串；不要使用带 URL 特殊符号的数据库密码。
POSTGRES_PASSWORD=
# 可留空：留空时首次启动自动生成并保存在 appdata 卷（需与数据库一起备份）
JWT_SECRET=
CONFIG_ENCRYPTION_KEY=
