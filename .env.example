# 仅服务器基础配置。京东 / 企业微信凭证在后台填写，加密保存在数据库。
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://rebate:YOUR_DATABASE_PASSWORD@127.0.0.1:54329/rebate
# 至少 32 字符的随机 JWT 密钥
JWT_SECRET=
# 32 字节十六进制 AES-GCM 密钥；必须与数据库一起备份，不可随意替换
CONFIG_ENCRYPTION_KEY=
# Docker 入口；局域网 / NAS 部署可设置 WEB_BIND=0.0.0.0
WEB_BIND=127.0.0.1
WEB_PORT=8081
